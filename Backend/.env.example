GEMINI_API_KEY="your_gemini_api_key_here"
DATABASE_URL=""
JWT_SECRET="your_secure_jwt_secret_here"
FRONTEND_ORIGINS=""

# Email (Gmail SMTP) for password reset codes. SMTP_PASSWORD is a Gmail App Password,
# created at https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_gmail_address@gmail.com"
SMTP_PASSWORD="your_16_char_app_password"
EMAIL_FROM="Budget Buddy <your_gmail_address@gmail.com>"

# Web Push (VAPID). Generate once with:  python3 scripts/generate_vapid_keys.py
# Changing them invalidates every device subscription.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@budgetbuddy.app"

# Timezone used for "today", reminders and quiet hours
APP_TIMEZONE="Asia/Kolkata"

# Set to "production" on the live server: hides the API docs page, drops the
# localhost CORS origins and turns on HTTPS-only (HSTS). Leave unset locally.
# Also start the live server with:  uvicorn main:app --proxy-headers --forwarded-allow-ips="*"
# so login rate limits see each visitor's real IP address.
APP_ENV=
